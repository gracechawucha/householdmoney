# Supabase project  (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Shared household key. Must match the value you insert into private.app_config (see README).
# Optional: leave this out and the app asks for the key on first open instead (stored on that phone only).
VITE_APP_KEY=pick-a-long-random-string
